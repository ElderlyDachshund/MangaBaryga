# Локальный HTTP-сервер и веб-панель
NODE_ENV=development
HOST=127.0.0.1
PORT=3017

# Первый запуск лучше делать вручную из панели.
AUTO_START_BOT=false

# Безопасные значения для первого запуска: бот анализирует обмены, но не принимает их.
SAFE_MODE=true
AUTO_ACCEPT_ENABLED=false

# Локальные постоянные данные. Эти каталоги исключены из Git.
DATABASE_PATH=data/baryga-manga.sqlite
MANGABUFF_STORAGE_STATE_PATH=playwright/.auth/mangabuff.json

# Нужны для автологина и автоматического восстановления истёкшей сессии.
MANGABUFF_LOGIN=your_mangabuff_login
MANGABUFF_PASSWORD=your_mangabuff_password
MANGABUFF_AUTO_LOGIN_INTERVAL_HOURS=20
MANGABUFF_AUTH_RETRY_MINUTES=5

# Telegram обязателен для запуска бота.
MANGA_TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Раскомментируй, только если Mangabuff должен открываться через отдельный прокси.
# MANGABUFF_PROXY_URL=socks5://user:password@proxy-host:proxy-port

# Ритм обхода. Значения по умолчанию: пауза между проходами берётся случайно из
# диапазона от минимума в панели до его удвоения (30-60 секунд), лимит обменов за
# проход снят (0), бюджет переходов — 20 в минуту и 300 в час.
# MANGABUFF_OFFERS_PAUSE_JITTER_FRACTION=1
# MANGABUFF_TRADE_DETAILS_PER_PASS=0
# MANGABUFF_NAVIGATIONS_PER_MINUTE=20
# MANGABUFF_NAVIGATIONS_PER_HOUR=300

# Минимальная пауза между переходами. Счётчики выше ограничивают только количество
# в окне, поэтому без этой паузы бот может выпустить весь минутный бюджет подряд.
# Замеры показали у Mangabuff «ведро» примерно на 32 запроса с пополнением 1.33/с:
# всё, что медленнее 750 мс, не упрётся в лимит никогда.
# MANGABUFF_NAVIGATION_MIN_GAP_MS=800

# Пауза между HTTP-запросами (не меньше 750 мс) и ожидание после 429.
# Mangabuff не присылает Retry-After и восстанавливается за ~5 секунд.
# MANGABUFF_HTTP_REQUEST_DELAY_MS=1500
# MANGABUFF_HTTP_RATE_LIMIT_RETRY_MS=10000

# Для локального Vite-режима VITE_API_BASE_URL не нужен: /api проксируется на 3017.
# VITE_API_BASE_URL=

# WEB_ORIGIN нужен только при размещении панели и API на разных публичных доменах.
# WEB_ORIGIN=https://your-web-panel.example.com
